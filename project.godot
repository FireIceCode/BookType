; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="BookType"
config/description="Improve your typing by typing books you own, or public domain masterpieces."
config/version="0.1"
run/main_scene="res://game/main/main.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="uid://dtkoiaxkqoem2"
config/icon="uid://cv5uxtqybhbvr"
boot_splash/minimum_display_time=1000

[autoload]

BookHandler="*res://game/global/book_handler.gd"
Game="*res://game/global/game.gd"
MessageService="*uid://xgib6ts11o2y"

[display]

window/size/viewport_width=1150
window/size/viewport_height=655
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[global_group]

scene_manager=""
scene_animation_player="solo AnimationPlayer for transitioning scenes"

[gui]

theme/default_font_generate_mipmaps=true

[input]

